# ===================================================
# POSWarkop - Environment Variables Configuration
# ===================================================
# Salin file ini menjadi `.env.local` dan isi nilainya.

# ---------------------------------------------------
# 1. Supabase Public Credentials (Client & Server)
# ---------------------------------------------------
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ---------------------------------------------------
# 2. Supabase Secret Credentials (Server Side Only)
# ---------------------------------------------------
# PERINGATAN: JANGAN gunakan awalan NEXT_PUBLIC_ agar kunci ini TIDAK bocor ke browser!
# Digunakan oleh Next.js Server Actions untuk User Management (tambah kasir, ubah role).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ---------------------------------------------------
# 3. Application Configuration
# ---------------------------------------------------
# URL utama aplikasi untuk callback Auth & environment
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set 'true' jika ingin menggunakan Mock Data / LocalStorage (Offline Demo Mode)
# Set 'false' untuk menggunakan Supabase Backend sepenuhnya
NEXT_PUBLIC_ENABLE_MOCK_STORAGE=true
